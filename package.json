{
  "name": "osiris-studio-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check && node scripts/build-static.mjs",
    "check": "node scripts/validate-site.mjs && node --check js/app.js && node --check js/content.js && node --check server.mjs && node --check scripts/render-page.mjs",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "npm run build && playwright test",
    "test:chromium": "npm run build && playwright test --project=chromium",
    "preview": "node server.mjs --built"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
